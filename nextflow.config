// Nextflow configuration for the AHRR human read removal pipeline.
//
// The k-mer database is read from params.db on the node that runs the task.
// It is deliberately NOT a per-job parameter and is never staged from user
// input: the database stays node-side and is never returned to the submitter.

manifest {
    name        = 'ahrr'
    author      = 'Aaron Berkman, Mamana Mbiyavanga, Shaun Aron, Scott Hazelhurst'
    description = 'NCBI sra-human-scrubber wrapped as a Nextflow workflow for GA4GH WES execution'
    mainScript  = 'main.nf'
    nextflowVersion = '>=23.10.0'
}

// Resource defaults. Raise these for large inputs; a multi-gigabyte database
// needs memory well above the default.
params.cpus = params.cpus ?: 2
params.mem  = params.mem  ?: '4 GB'

params.container = params.container ?: 'afrigend/sra-human-scrubber:2.2.1'

process {
    withName: SCRUB {
        container = params.container
        cpus      = params.cpus
        memory    = params.mem
        time      = '48 h'
    }
}

profiles {
    // Kubernetes. Every value below is site-specific: set them for your own
    // cluster, either on the command line or in a params file. WES injects no
    // storage configuration, so the workflow must tell task pods how to reach
    // the shared work directory and the database.
    k8s {
        // Shared Nextflow work directory, mounted at the same path in the head
        // pod and in every task pod so they share state.
        params.workClaim      = params.workClaim      ?: 'workspace-pvc'
        params.workMountPath  = params.workMountPath  ?: '/mnt/workspace'
        // Read-only volume carrying the k-mer database.
        params.dbClaim        = params.dbClaim        ?: 'reference-data-pvc'
        params.dbMountPath    = params.dbMountPath    ?: '/mnt/reference-data'
        // Restrict scheduling to nodes that hold the image and the database.
        // Set to null to schedule cluster-wide (requires a reachable registry).
        params.nodeSelector   = params.nodeSelector   ?: 'scrubber-image=true'

        process.executor = 'k8s'
        k8s {
            // Namespace and service account are inherited from the context the
            // WES head pod is placed in, so the workflow runs unchanged
            // wherever it lands.
            storageClaimName = params.workClaim
            storageMountPath = params.workMountPath
            // Task pods must not run as root. The UID must match the owner of
            // the database on the underlying storage: an NFS export with
            // root_squash maps a root pod to `nobody`, which can then read the
            // database only through its world bits. Presenting the owning UID
            // instead lets the database be tightened to 0640. Change this UID
            // and the database ownership together, or every job will fail.
            securityContext = [
                runAsUser    : 1000,
                runAsGroup   : 1000,
                fsGroup      : 1000,
                runAsNonRoot : true,
            ]
        }
        process {
            withName: SCRUB {
                // Repeated inside the profile deliberately. The k8s executor
                // does not reliably merge the base process block, and without
                // these the task pod is created with no requests or limits at
                // all, so a multi-gigabyte database is scheduled unconstrained.
                container = params.container
                cpus      = params.cpus
                memory    = params.mem
                pod = [
                    [ volumeClaim: params.dbClaim, mountPath: params.dbMountPath, readOnly: true ],
                    [ imagePullPolicy: 'IfNotPresent' ],
                ] + ( params.nodeSelector ? [[ nodeSelector: params.nodeSelector ]] : [] )
            }
        }
        // Under k8s the database is on the mounted read-only volume rather
        // than inside the image. Override with --db for a different layout.
        params.db = params.db ?: "${params.dbMountPath}/scrubber/human_filter.db"
    }
    docker {
        docker.enabled = true
        // Run the task container as the invoking user rather than the image's
        // USER. The Nextflow head creates the work directory as whoever it runs
        // as; the image drops to a non-root UID, which then cannot write there:
        //   touch: cannot touch '.command.trace': Permission denied
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
}
